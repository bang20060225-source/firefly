# 반딧불이 환경변수 예시
# 이 파일을 복사해서 `.env.local` 파일을 만들고 값을 채워 주세요.
#   cp .env.example .env.local
# `.env.local`은 Git에 올라가지 않아요.

# ──────────────────────────────────────────────
# 브라우저에 노출되어도 되는 값 (VITE_ 접두사)
# Supabase 대시보드 → Project Settings → API Keys 에서 확인
# ──────────────────────────────────────────────

# Supabase 프로젝트 주소 (예: https://abcdefgh.supabase.co)
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_... 로 시작). RLS가 켜져 있을 때만 브라우저에서 안전해요.
VITE_SUPABASE_PUBLISHABLE_KEY=

# 두 값이 비어 있으면 앱은 DEMO 모드로 실행돼요. (서버 없이 이 기기 안에서만 동작)

# ──────────────────────────────────────────────
# 주의: 서버 비밀 키(sb_secret_..., service_role)는 여기에 넣지 마세요.
# 비밀 키는 Supabase Edge Function 환경에서만 사용하고,
# VITE_ 접두사를 절대 붙이지 않아요. (붙이면 브라우저에 그대로 노출돼요)
# ──────────────────────────────────────────────
